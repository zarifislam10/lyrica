# Copy this file to .env and add your key there. Never commit .env.
ELEVENLABS_API_KEY=
# George, the voice used in the ElevenLabs quickstart.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v4

# Round commentary. Set both API keys for live generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Aux speech model. Defaults to eleven_v3 (newest, most expressive).
# eleven_flash_v2_5 is faster if the 5s budget starts slipping.
ELEVENLABS_ROUND_MODEL_ID=eleven_v3
# Aux's voice. Optional: defaults to Freya (young, upbeat, enthusiastic).
# Separate from ELEVENLABS_VOICE_ID so it never changes the "Hear it" clips.
ELEVENLABS_ANNOUNCER_VOICE_ID=
# Comma-separated browser origins; add the deployed frontend origin when deploying.
FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173

# "Hear it" clips (generate_hear_it.py). Optional: the voice falls back to
# ELEVENLABS_VOICE_ID; the model needs Korean and Arabic support.
ELEVENLABS_HEAR_IT_VOICE_ID=
ELEVENLABS_HEAR_IT_MODEL_ID=eleven_multilingual_v2

# Tiger Data (TimescaleDB) connection for the leaderboard. Leaving this
# empty makes every leaderboard write and read a silent no-op; the app
# still runs, the UI panel just shows an empty list.
DATABASE_URL=
